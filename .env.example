# ==========================================
# Gridiron AI - Environment Configuration
# ==========================================

# LLM Providers (Free Tier)
GOOGLE_API_KEY=your_google_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ESPN Fantasy Credentials & League Config
ESPN_LEAGUE_ID=your_espn_league_id_here
ESPN_TEAM_ID=your_team_id_here
ESPN_S2=your_espn_s2_cookie_here
ESPN_SWID=your_espn_swid_cookie_here
ESPN_YEAR=2026

# Infrastructure
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+asyncpg://gridiron:gridiron@postgres:5432/gridiron

# Discord Relay Bot
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_general_channel_id_here
DISCORD_ALERTS_CHANNEL_ID=your_league_alerts_channel_id_here
DISCORD_DIGEST_CHANNEL_ID=your_league_digest_channel_id_here
DISCORD_USER_ID=your_discord_user_id_for_dms_here

# League & Roster Rules
SCORING_FORMAT=ppr
LEAGUE_SIZE=10
NUM_WR_SLOTS=3
HAS_FLEX=true
PASSING_YARDS_PER_POINT=20
IS_SUPERFLEX=false
IS_TE_PREMIUM=false
BENCH_SLOTS=4
IR_SLOTS=1

# Model Architecture Configuration (Free Tier Optimized)
SUPERVISOR_MODEL=gemini-3.5-flash
FAST_MODEL=qwen/qwen3.6-27b
HEAVY_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=models/text-embedding-004

# Proactive League Monitor & Throttling
MAX_PROACTIVE_LLM_PER_DAY=25
LEAGUE_MONITOR_INTERVAL_MINUTES=10
NEWS_POLL_INTERVAL_MINUTES=15
LLM_CACHE_TTL_HOURS=4
